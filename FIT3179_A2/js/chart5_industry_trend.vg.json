{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "padding": {
    "left": 5,
    "right": 20,
    "top": 20,
    "bottom": 5
  },
  "data": {
    "url": "data/clean/trend_2021_2025.csv",
    "format": {
      "parse": {
        "production_value_m": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.nut_type === 'All Nuts (Industry Total)'"
    },
    {
      "calculate": "'$' + format(datum.production_value_m, ',.1f') + 'm'",
      "as": "value_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#876b50",
        "strokeWidth": 2.5
      },
      "encoding": {
        "y": {
          "field": "production_value_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1800
            ]
          },
          "title": "Production value (A$m)",
          "axis": {
            "grid": true,
            "gridColor": "#EEEEEE"
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "color": "#876b50",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "y": {
          "field": "production_value_m",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "value_label",
            "type": "nominal",
            "title": "Production value"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year !== 2023"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 11,
        "color": "#222222"
      },
      "encoding": {
        "y": {
          "field": "production_value_m",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2023"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 16,
        "fontSize": 11,
        "color": "#222222"
      },
      "encoding": {
        "y": {
          "field": "production_value_m",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2023,
            "annotation_y": 460,
            "note": "2023: −39.6% from 2022",
            "nut_type": "All Nuts (Industry Total)",
            "production_value_m": 460
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#885239",
        "dx": 0,
        "align": "center"
      },
      "encoding": {
        "y": {
          "field": "annotation_y",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2025,
            "annotation_y": 1380,
            "note": "2025: highest in this\nfive-year series",
            "nut_type": "All Nuts (Industry Total)",
            "production_value_m": 1200
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#885239",
        "dx": -8,
        "align": "right",
        "lineBreak": "\n",
        "lineHeight": 14,
        "baseline": "top"
      },
      "encoding": {
        "y": {
          "field": "annotation_y",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2025,
            "a": 1410,
            "b": 1630
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "rule",
        "color": "#885239",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "a",
          "type": "quantitative"
        },
        "y2": {
          "field": "b"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#766a60",
      "titleColor": "#30241e",
      "gridColor": "#ded4c7",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelColor": "#30241e",
      "titleColor": "#30241e",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "font": "-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif",
    "title": {
      "fontSize": 14,
      "color": "#30241e"
    }
  },
  "background": "#f4efe6"
}
